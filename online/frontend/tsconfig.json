{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true,
    "rootDir": ".", "outDir": "dist", "types": ["vite/client", "node", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "e2e"]
}
